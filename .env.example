# Environment configuration for Lyra Music
# Copy this file to `.env` and replace placeholder values before running the app.

# SQLite connection string used by Drizzle ORM and the runtime server.
DATABASE_URL="./db.sqlite"

# Required runtime signing key. Generate once; keep it private and persistent:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Values shorter than 32 characters and example placeholders are rejected.
NUXT_JWT_SECRET=""

# User agent string required by the MusicBrainz API.
# Example: YourAppName/1.0.0 ( contact@example.com )
MUSICBRAINZ_USER_AGENT="Lyra/0.0.40 (contact@example.com)"

# Required access code for signups in production (development bypasses the check).
SECRET_ACCESS_CODE="set-an-access-code"

# Genius API credentials (https://docs.genius.com/)
GENIUS_API_CLIENT_ID=""
GENIUS_API_CLIENT_SECRET=""

# Local Whistle transcription: Python + ffmpeg, no API key. See docs/whistle.md.
# Use the Python executable from the virtual environment where cactus-needle is installed.
# Windows: C:/path/to/lyra/.venv-whistle/Scripts/python.exe
# macOS/Linux: /path/to/lyra/.venv-whistle/bin/python
WHISTLE_PYTHON=""
WHISTLE_MODEL_PATH=""
WHISTLE_FFMPEG_PATH="ffmpeg"
WHISTLE_TIMEOUT_MS="300000"
WHISTLE_MAX_DURATION_SECONDS="1200"

# Toggle for scanner integrations that hit the Genius API.
# Accepts "true" or "false" (defaults to false when unset).
SCANNER_DISABLE_GENIUS="false"

# Local semantic search, recommendations and suggested tags. See docs/embeddinggemma.md.
# Download the pinned model once, then run inference offline without an API key.
NUXT_EMBEDDING_PYTHON="python"
NUXT_EMBEDDING_MODEL="google/embeddinggemma-2"
NUXT_EMBEDDING_REVISION="914f7f89142e33e77833254d9c9b90c3cef7303b"
NUXT_EMBEDDING_DIMENSIONS="256"
NUXT_EMBEDDING_TIMEOUT_MS="300000"
NUXT_EMBEDDING_MAX_TRACKS="2000"
